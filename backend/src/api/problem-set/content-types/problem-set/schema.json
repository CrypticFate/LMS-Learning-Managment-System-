{
  "kind": "collectionType",
  "collectionName": "problem_sets",
  "info": {
    "singularName": "problem-set",
    "pluralName": "problem-sets",
    "displayName": "Problem Set",
    "description": "Curated DSA practice problems grouped by topic"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "category": { "type": "string", "required": true },
    "difficulty": {
      "type": "enumeration",
      "enum": ["easy", "medium", "hard"],
      "default": "medium",
      "required": true
    },
    "problemUrl": { "type": "string", "required": true },
    "description": { "type": "text" },
    "order": { "type": "integer", "default": 0 },
    "progressRecords": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::problem-progress.problem-progress",
      "mappedBy": "problemSet"
    }
  }
}
