{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "quizzes",
      "required": true
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.question",
      "required": true
    },
    "attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-attempt.quiz-attempt",
      "mappedBy": "quiz"
    }
  }
}
