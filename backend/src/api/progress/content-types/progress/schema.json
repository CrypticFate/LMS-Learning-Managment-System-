{
  "kind": "collectionType",
  "collectionName": "progress",
  "info": {
    "singularName": "progress",
    "pluralName": "progresses",
    "displayName": "Lesson Completion",
    "description": "One persisted lesson completion per student, course, and lesson"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "required": true
    },
    "completedAt": {
      "type": "datetime",
      "required": true
    }
  }
}
