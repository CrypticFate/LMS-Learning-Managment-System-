{
  "kind": "collectionType",
  "collectionName": "modules",
  "info": {
    "singularName": "module",
    "pluralName": "modules",
    "displayName": "Module",
    "description": "A module groups lessons and quizzes within a course"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "description": { "type": "text" },
    "order": { "type": "integer", "default": 0 },
    "courses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course.course",
      "inversedBy": "modules"
    },
    "lessons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::lesson.lesson",
      "inversedBy": "modules"
    },
    "quizzes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::quiz.quiz",
      "inversedBy": "modules"
    }
  }
}
