# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Generate production values with: openssl rand -base64 32
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Local SQLite configuration
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Railway PostgreSQL configuration (replace SQLite values in production)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
